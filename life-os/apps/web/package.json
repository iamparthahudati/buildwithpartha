{
  "name": "@buildwithpartha/life-os-web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "npm@11.13.0",
  "engines": {
    "node": ">=22.12.0",
    "npm": ">=10.0.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "build:test": "npm run typecheck && vite build --mode test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint . --max-warnings 0",
    "preview": "vite preview",
    "test:coverage": "vitest run --coverage",
    "test:unit": "vitest run",
    "typecheck": "tsc --noEmit",
    "verify:boundaries": "node scripts/verify-module-boundaries.mjs",
    "verify:dependencies": "node ../../scripts/validate-dependency-locks.mjs",
    "verify:gateway": "node --test tests/local-gateway.test.mjs",
    "verify:quality": "npm run format:check && npm run lint && npm run typecheck && npm run verify:boundaries && npm run verify:tokens",
    "test": "npm run verify:quality && npm run test:coverage && npm run build:test && node --test tests/*.test.mjs",
    "verify:tokens": "node scripts/verify-design-tokens.mjs"
  },
  "dependencies": {
    "@tanstack/react-query": "5.101.4",
    "lucide-react": "1.31.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-router-dom": "7.18.2"
  },
  "devDependencies": {
    "@babel/core": "7.29.7",
    "@babel/eslint-parser": "7.29.7",
    "@babel/preset-typescript": "7.29.7",
    "@eslint/js": "9.39.5",
    "@testing-library/dom": "10.4.1",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.4",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitejs/plugin-react": "6.0.5",
    "@vitest/coverage-v8": "4.1.10",
    "axe-core": "4.13.0",
    "eslint": "9.39.5",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.4",
    "globals": "17.11.0",
    "jsdom": "27.4.0",
    "prettier": "3.9.6",
    "typescript": "7.0.2",
    "vite": "8.2.1",
    "vitest": "4.1.10"
  },
  "browserslist": {
    "production": [
      "Chrome >= 111",
      "Edge >= 111",
      "Firefox >= 114",
      "Safari >= 16.4",
      "iOS >= 16.4"
    ],
    "development": [
      "last 1 Chrome version",
      "last 1 Firefox version",
      "last 1 Safari version"
    ]
  }
}
